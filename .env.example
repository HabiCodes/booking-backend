# ============================================================================
# Event Booking Platform — Production Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# On Render, these same variables are configured through the dashboard and
# `render.yaml`.
# ============================================================================

# Runtime
NODE_ENV=production
PORT=4000

# ============================================================================
# Database — PostgreSQL (use DATABASE_URL for Render's managed PostgreSQL,
# or the individual DB_* variables for local/self-hosted Postgres)
# ============================================================================
DATABASE_URL=

# Optional — individual values (used only when DATABASE_URL is empty)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CONNECTION_LIMIT=20
# Set to false in production if you manage migrations yourself
DB_RUN_MIGRATIONS=true

# ============================================================================
# JWT Secrets — generate strong random strings (>= 32 chars). NEVER reuse.
# Use: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================================
JWT_SECRET=replace-with-strong-random-string-min-32-chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace-with-different-strong-random-string-min-32-chars
ADMIN_JWT_EXPIRES_IN=12h

# ============================================================================
# CORS — comma-separated list of allowed origins, or "*" for any
# ============================================================================
CORS_ORIGIN=

# ============================================================================
# Admin account bootstrap — used by `npm run seed:admin`
# Leave ADMIN_SEED_ON_BOOT=false in production after first deploy.
# ============================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_SEED_ON_BOOT=false

# ============================================================================
# Optional — file uploads, Sockets, Redis
# ============================================================================
UPLOAD_DIR=uploads
SOCKET_PORT=
REDIS_URL=

# ============================================================================
# Email delivery (Resend)
# Get your API key at https://resend.com/api-keys
# The FROM address MUST belong to a verified domain in your Resend account.
# In dev/test, leave RESEND_API_KEY empty — emails are logged to the console.
# ============================================================================
RESEND_API_KEY=
EMAIL_FROM=info@bigmembres.in
# Public base URL used inside verification / password-reset email links.
# Set to your deployed frontend URL (e.g. https://bookmyturf.in).
APP_URL=
